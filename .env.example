# Vaani — Example Environment Variables
# Copy this to .env and fill in your keys.
# The system works without any of these — they unlock cloud features.

# ── Speech-to-Text ──────────────────────────────────────────────────────────
# Sarvam AI (preferred for Indic languages): https://www.sarvam.ai/
SARVAM_API_KEY=

# ElevenLabs (alternative STT): https://elevenlabs.io/
ELEVENLABS_API_KEY=

# ── LLM (enriched answers) ──────────────────────────────────────────────────
# Anthropic Claude (for LLM-mode generation): https://www.anthropic.com/
ANTHROPIC_API_KEY=

# ── Dataset ─────────────────────────────────────────────────────────────────
# HuggingFace token to stream MSMARCO-XI live (optional; offline corpus is bundled)
HF_TOKEN=

# ── Tuning ──────────────────────────────────────────────────────────────────
VAANI_PORT=7860
VAANI_GENERATOR=extractive
VAANI_DATASET_SOURCE=auto
VAANI_BUDGET_MS=200
VAANI_GUARDRAILS=true
